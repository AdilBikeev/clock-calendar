{
  "name": "clock-calendar",
  "version": "1.0.0",
  "description": "Apple-style calendar application",
  "private": true,
  "scripts": {
    "dev": "node start-dev.js",
    "dev:build": "webpack --mode development --watch",
    "dev:server": "node dev-server.js",
    "build": "webpack --mode production",
    "build:watch": "webpack --mode development --watch",
    "preview": "npm run build && node dev-server.js",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:copy": "npx cap copy",
    "android": "npm run build && npx cap sync && npx cap open android",
    "ios": "npm run build && npx cap sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "date-fns": "^2.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "simplebar": "^6.3.3",
    "simplebar-react": "^3.3.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/webpack-env": "^1.18.0",
    "css-loader": "^6.11.0",
    "dotenv": "^16.4.5",
    "dotenv-webpack": "^8.1.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.2.2",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
